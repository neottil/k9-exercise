{
  "name": "k9-exercise",
  "private": true,
  "version": "1.5.4",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "lock:docker": "bash scripts/docker-lock.sh",
    "version": "npm version --no-commit-hooks --no-git-tag-version --prefix"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "mongoose": "^9.6.3",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  }
}
